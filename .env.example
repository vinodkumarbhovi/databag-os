# databag settings through the environment. Copy to .env (Docker) or add them in your host's dashboard (Vercel).
# Anything not set here falls back to the settings file or the defaults (local Gemma 4 through Ollama).

# ---- AI: pick ONE ----
# A) Local model through Ollama (laptop, desktop, VM, server, Docker --profile local-ai)
# DATABAG_AI_BASE_URL=http://127.0.0.1:11434/v1      # Docker on a Mac: http://host.docker.internal:11434/v1
# DATABAG_AI_MODEL=gemma4:e4b
# B) OpenRouter (cloud, Vercel, small machines). Leave DATABAG_AI_BASE_URL unset or empty.
# OPENROUTER_API_KEY=sk-or-...
# DATABAG_AI_MODEL=google/gemini-2.5-flash           # must support tool calling (the agent)
# DATABAG_SPEECH_MODEL=google/gemini-2.5-flash       # must accept audio input (dictation)

# ---- Database ----
# Unset: a SQLite file in DATABAG_HOME (default ~/.databag-os, /data in Docker).
# Cloud (Vercel): a Turso / libSQL database shared by every server.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=...

# ---- Cloud ----
# DATABAG_URL=https://databag.yourcompany.com         # public address used in signing links, booking pages, invitations
# CRON_SECRET=a-long-random-string                    # protects /api/cron (Vercel sends it automatically)

# ---- Mail to the outside world (optional) ----
# MAIL_RELAY_HOST=smtp.resend.com
# MAIL_RELAY_PORT=587
# MAIL_RELAY_USER=resend
# MAIL_RELAY_PASS=...

# ---- Other ----
# DATABAG_APPS=mail,calendar,docs,sheets,crm,accounting   # which apps to show (default: all)
# DATABAG_CURRENCY=EUR
